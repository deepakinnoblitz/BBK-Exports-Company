 "css": "\n.print-format {\n    page-size: A5;\n    orientation: Landscape;\n    margin-top: 6.0mm;\n    margin-bottom: 5.0mm;\n    margin-left: 8.0mm;\n    margin-right: 8.0mm;\n    padding: 0 !important;\n}\n\n@media print {\n    html, body {\n        margin: 0 !important;\n        padding: 0 !important;\n        background: #fff !important;\n        -webkit-print-color-adjust: exact;\n        print-color-adjust: exact;\n        width: 100% !important;\n        font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif !important;\n        font-size: 7.5px !important;\n        line-height: 1.15 !important;\n        color: #333 !important;\n    }\n\n    @page {\n        size: A5 landscape;\n        margin: 5.0mm 8.0mm 4.0mm 8.0mm;\n    }\n\n    .print-format {\n        padding: 0 !important;\n        margin: 0 !important;\n    }\n\n    .container {\n        width: 100% !important;\n        max-width: 100% !important;\n        box-sizing: border-box !important;\n        margin: 0 auto !important;\n        padding: 0 !important;\n        border: 1px solid #ccc !important;\n        background: #fff !important;\n        page-break-inside: avoid !important;\n        break-inside: avoid !important;\n        zoom: 0.88;\n    }\n}\n\n* {\n    box-sizing: border-box;\n}\n\n.container {\n    width: 100%;\n    max-width: 100%;\n    margin: 0 auto;\n    background: #fff;\n    padding: 0;\n    border: 1px solid #ccc;\n    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;\n    font-size: 7.5px;\n    line-height: 1.15;\n    color: #333;\n    zoom: 0.88;\n}\n\n\n.watermark {\n    position: fixed;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    opacity: 0.08;\n    z-index: 0;\n    pointer-events: none;\n    user-select: none;\n}\n",
