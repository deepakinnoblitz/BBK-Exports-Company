 "html": "<div class=\"watermark\">\n    <img src=\"https://www.innoblitz.global/images/logo-dark.png\" style=\"width: 130px;\">\n</div>\n\n<div class=\"container\" style=\"page-break-inside: avoid !important; break-inside: avoid !important;\">\n    <!-- Header -->\n    <div style=\"width: 100%; border-bottom: 1px solid #e0e0e0; padding-bottom: 2px;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <td style=\"vertical-align: middle; width: 65%;\">\n                    <table style=\"border-collapse: collapse;\">\n                        <tr>\n                            <td style=\"vertical-align: middle; padding-right: 6px;\">\n                                <img src=\"https://erp.innoblitz.in/assets/Innoblitz%20Logo%20Full.png\" alt=\"Innoblitz Logo\" style=\"height: 22px; width: auto; display: block;\">\n                            </td>\n                            <td style=\"vertical-align: middle;\">\n                                <div style=\"font-size: 9px; font-weight: 700; color: #2d3436; line-height: 1.1;\">Innoblitz Technologies & Systems Pvt Ltd</div>\n                                <div style=\"font-size: 6.5px; color: #636e72; line-height: 1.15; margin-top: 1px;\">\n                                    14/18, 1st Floor, Govinda St, Ayyavoo Colony, Aminjikarai, Chennai - 600029.<br>\n                                    Phone: 9500359896 | Email: info@innoblitz.global | GSTIN: 33AAECI7847L1Z5\n                                </div>\n                            </td>\n                        </tr>\n                    </table>\n                </td>\n                <td style=\"vertical-align: middle; text-align: right; width: 35%;\">\n                    <div style=\"font-size: 7px; color: #636e72;\">Payslip For the Month</div>\n                    <div style=\"font-size: 10px; font-weight: 700; color: #2d3436; line-height: 1.1;\">{{ frappe.utils.formatdate(doc.pay_period_start, \"MMMM yyyy\") }}</div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Employee Summary & Net Pay Card -->\n    <div style=\"width: 100%; margin: 2px 0;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <!-- Employee Details (Left 65%) -->\n                <td style=\"width: 65%; vertical-align: top; padding-right: 5px;\">\n                    <div style=\"font-size: 7px; font-weight: 700; color: #636e72; text-transform: uppercase; margin-bottom: 1px;\">Employee Summary</div>\n                    <table style=\"width: 100%; border-collapse: collapse; font-size: 6.8px;\">\n                        <tr>\n                            <td style=\"color: #636e72; width: 22%; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">Employee Name</td>\n                            <td style=\"color: #b2bec3; width: 3%; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; width: 25%; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ doc.employee_name or \"Nil\" }}</td>\n                            <td style=\"color: #636e72; width: 22%; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0; padding-left: 5px;\">Account No</td>\n                            <td style=\"color: #b2bec3; width: 3%; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; width: 25%; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ doc.account_no or \"Nil\" }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"color: #636e72; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">Department</td>\n                            <td style=\"color: #b2bec3; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ doc.department or \"Nil\" }}</td>\n                            <td style=\"color: #636e72; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0; padding-left: 5px;\">PF No</td>\n                            <td style=\"color: #b2bec3; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ doc.pf_no or \"Nil\" }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"color: #636e72; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">Designation</td>\n                            <td style=\"color: #b2bec3; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ doc.designation or \"Nil\" }}</td>\n                            <td style=\"color: #636e72; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0; padding-left: 5px;\">ESI No</td>\n                            <td style=\"color: #b2bec3; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ doc.esi_no or \"Nil\" }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"color: #636e72; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">Date of Joining</td>\n                            <td style=\"color: #b2bec3; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ frappe.utils.formatdate(doc.date_of_joining, \"dd-MM-yyyy\") if doc.date_of_joining else \"Nil\" }}</td>\n                            <td style=\"color: #636e72; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0; padding-left: 5px;\">Employee ID</td>\n                            <td style=\"color: #b2bec3; padding: 0.5px;\">:</td>\n                            <td style=\"color: #2d3436; font-weight: 600; padding: 0.5px 0; border-bottom: 1px dotted #e0e0e0;\">{{ doc.employee or \"Nil\" }}</td>\n                        </tr>\n                    </table>\n                </td>\n\n                <!-- Net Pay & Attendance Card (Right 35%) -->\n                <td style=\"width: 35%; vertical-align: top; background: rgba(200, 230, 201, 0.35); border-left: 2.5px solid #4caf50; padding: 2px 5px; border-radius: 3px;\">\n                    <table style=\"width: 100%; border-collapse: collapse;\">\n                        <tr>\n                            <td style=\"vertical-align: middle;\">\n                                <div style=\"font-size: 10.5px; font-weight: 700; color: #2d3436; line-height: 1;\">\u20b9{{ \"{:,.0f}\".format(doc.net_pay) }}</div>\n                                <div style=\"font-size: 6px; color: #636e72; font-weight: 600;\">Employee Net Pay</div>\n                            </td>\n                        </tr>\n                    </table>\n                    <div style=\"margin-top: 1.5px; padding-top: 1.5px; border-top: 1px dotted rgba(0,0,0,0.15);\">\n                        <table style=\"width: 100%; font-size: 6.2px; border-collapse: collapse;\">\n                            <tr>\n                                <td style=\"color: #636e72; padding: 0.5px 0;\">Total Working Days</td>\n                                <td style=\"color: #b2bec3; padding: 0 2px;\">:</td>\n                                <td style=\"color: #2d3436; font-weight: 600; text-align: right;\">{{ doc.total_working_days or 0 }}</td>\n                                <td style=\"color: #636e72; padding: 0.5px 0; padding-left: 5px;\">Leave Taken</td>\n                                <td style=\"color: #b2bec3; padding: 0 2px;\">:</td>\n                                <td style=\"color: #2d3436; font-weight: 600; text-align: right;\">{{ doc.no_of_leave or 0 }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"color: #636e72; padding: 0.5px 0;\">LOP Days</td>\n                                <td style=\"color: #b2bec3; padding: 0 2px;\">:</td>\n                                <td style=\"color: #2d3436; font-weight: 600; text-align: right;\">{{ doc.lop_days or 0 }}</td>\n                                <td style=\"color: #636e72; padding: 0.5px 0; padding-left: 5px;\">CL Balance</td>\n                                <td style=\"color: #b2bec3; padding: 0 2px;\">:</td>\n                                <td style=\"color: #059669; font-weight: 700; text-align: right;\">{{ \"{:.0f}\".format(doc.cl_balance | float) if doc.cl_balance is defined and doc.cl_balance is not none else \"0\" }} Days</td>\n                            </tr>\n                        </table>\n                    </div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Earnings & Deductions Tables (Side by Side) -->\n    <div style=\"width: 100%; margin: 1.5px 0; padding: 2px 5px; background: #fafafa; border-radius: 3px; border: 1px solid #e0e0e0;\">\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 6.8px;\">\n            <tr>\n                <!-- Earnings Column -->\n                <td style=\"width: 50%; vertical-align: top; padding-right: 6px;\">\n                    <table style=\"width: 100%; border-collapse: collapse;\">\n                        <tr style=\"border-bottom: 1.5px solid #dfe6e9;\">\n                            <td style=\"font-weight: 700; color: #636e72; text-transform: uppercase; padding: 1px 0;\">Earnings</td>\n                            <td style=\"font-weight: 700; color: #636e72; text-align: right; text-transform: uppercase; padding: 1px 0;\">Amount</td>\n                        </tr>\n                        {% for row in doc.earnings %}\n                        <tr>\n                            <td style=\"color: #2d3436; padding: 0.8px 0;\">{{ row.component_name or row.salary_component }}</td>\n                            <td style=\"color: #2d3436; font-weight: 600; text-align: right; padding: 0.8px 0;\">\u20b9 {{ \"{:,.2f}\".format(row.amount or 0) }}</td>\n                        </tr>\n                        {% endfor %}\n                        <tr style=\"border-top: 1.5px solid #2d3436; font-weight: 700;\">\n                            <td style=\"padding: 1.5px 0; color: #2d3436;\">Gross Earnings</td>\n                            <td style=\"padding: 1.5px 0; color: #2d3436; text-align: right;\">\u20b9 {{ \"{:,.2f}\".format(doc.gross_pay or 0) }}</td>\n                        </tr>\n                    </table>\n                </td>\n\n                <!-- Deductions Column -->\n                <td style=\"width: 50%; vertical-align: top; padding-left: 6px; border-left: 1px solid #e0e0e0;\">\n                    <table style=\"width: 100%; border-collapse: collapse;\">\n                        <tr style=\"border-bottom: 1.5px solid #dfe6e9;\">\n                            <td style=\"font-weight: 700; color: #636e72; text-transform: uppercase; padding: 1px 0;\">Deductions</td>\n                            <td style=\"font-weight: 700; color: #636e72; text-align: right; text-transform: uppercase; padding: 1px 0;\">Amount</td>\n                        </tr>\n                        {% if doc.lop and (doc.lop | float) > 0 %}\n                        <tr>\n                            <td style=\"color: #2d3436; padding: 0.8px 0;\">LOP</td>\n                            <td style=\"color: #2d3436; font-weight: 600; text-align: right; padding: 0.8px 0;\">\u20b9 {{ \"{:,.2f}\".format(doc.lop or 0) }}</td>\n                        </tr>\n                        {% endif %}\n                        {% for row in doc.deductions %}\n                        <tr>\n                            <td style=\"color: #2d3436; padding: 0.8px 0;\">{{ row.component_name or row.salary_component }}</td>\n                            <td style=\"color: #2d3436; font-weight: 600; text-align: right; padding: 0.8px 0;\">\u20b9 {{ \"{:,.2f}\".format(row.amount or 0) }}</td>\n                        </tr>\n                        {% endfor %}\n                        <tr style=\"border-top: 1.5px solid #2d3436; font-weight: 700;\">\n                            <td style=\"padding: 1.5px 0; color: #2d3436;\">Total Deductions</td>\n                            <td style=\"padding: 1.5px 0; color: #2d3436; text-align: right;\">\u20b9 {{ \"{:,.2f}\".format(doc.total_deduction or 0) }}</td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Leave Balance (Left 58%) & Total Net Payable (Right 42%) Side-by-Side -->\n    <div style=\"width: 100%; margin-top: 1.5px;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <!-- Leave Balance -->\n                <td style=\"width: 58%; vertical-align: top; padding-right: 5px;\">\n                    <div style=\"padding: 2px 4px; background: #f0fdf4; border-radius: 3px; border: 1px solid #bbf7d0;\">\n                        <div style=\"font-size: 6.8px; font-weight: 700; color: #166534; text-transform: uppercase;\">Leave Balance Summary</div>\n                        <table style=\"width: 100%; border-collapse: collapse; font-size: 6.2px; margin-top: 1px;\">\n                            <thead>\n                                <tr style=\"border-bottom: 1px solid #bbf7d0; color: #15803d; font-weight: 600;\">\n                                    <th style=\"text-align: left; padding: 0.5px 0;\">Leave Type</th>\n                                    <th style=\"text-align: left; padding: 0.5px 0;\">Cycle</th>\n                                    <th style=\"text-align: right; padding: 0.5px 0;\">Alloc</th>\n                                    <th style=\"text-align: right; padding: 0.5px 0;\">Taken</th>\n                                    <th style=\"text-align: right; padding: 0.5px 0; color: #166534; font-weight: 700;\">Balance</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                {% set leave_rows = json.loads(doc.leave_details) if doc.leave_details else [] %}\n                                {% if leave_rows and leave_rows | length > 0 %}\n                                    {% for row in leave_rows %}\n                                    <tr>\n                                        <td style=\"padding: 0.5px 0; font-weight: 600; color: #1f2937;\">{{ row.leave_type_name or row.leave_type }}</td>\n                                        <td style=\"padding: 0.5px 0; color: #4b5563;\">{{ row.period_label or row.cycle_label }}</td>\n                                        <td style=\"padding: 0.5px 0; text-align: right;\">{{ \"{:.0f}\".format(row.allocated | float) }}</td>\n                                        <td style=\"padding: 0.5px 0; text-align: right; color: #dc2626;\">{{ \"{:.0f}\".format(row.taken | float) }}</td>\n                                        <td style=\"padding: 0.5px 0; text-align: right; font-weight: 700; color: #059669;\">{{ \"{:.0f}\".format(row.balance | float) }} {{ row.uom }}</td>\n                                    </tr>\n                                    {% endfor %}\n                                {% else %}\n                                    <tr>\n                                        <td style=\"padding: 0.5px 0; font-weight: 600; color: #1f2937;\">Casual Leave (CL)</td>\n                                        <td style=\"padding: 0.5px 0; color: #4b5563;\">{{ doc.cl_cycle_period or ((\"Jan - Jun\" if (frappe.utils.getdate(doc.pay_period_start).month if doc.pay_period_start else 1) <= 6 else \"Jul - Dec\") ~ \" \" ~ (frappe.utils.getdate(doc.pay_period_start).year if doc.pay_period_start else \"\")) }}</td>\n                                        <td style=\"padding: 0.5px 0; text-align: right;\">{{ \"{:.0f}\".format(doc.cl_allocated | float) if doc.cl_allocated is defined and doc.cl_allocated is not none else \"0\" }}</td>\n                                        <td style=\"padding: 0.5px 0; text-align: right; color: #dc2626;\">{{ \"{:.0f}\".format(doc.cl_taken if doc.cl_taken is defined and doc.cl_taken is not none else doc.no_of_paid_leave or 0) }}</td>\n                                        <td style=\"padding: 0.5px 0; text-align: right; font-weight: 700; color: #059669;\">{{ \"{:.0f}\".format(doc.cl_balance | float) if doc.cl_balance is defined and doc.cl_balance is not none else \"0\" }} Days</td>\n                                    </tr>\n                                {% endif %}\n                            </tbody>\n                        </table>\n                    </div>\n                </td>\n\n                <!-- Final Payable & Words -->\n                <td style=\"width: 42%; vertical-align: top;\">\n                    <div style=\"background: rgba(200, 230, 201, 0.35); border: 1px solid #4caf50; border-radius: 3px; padding: 2px 5px;\">\n                        <table style=\"width: 100%; border-collapse: collapse;\">\n                            <tr>\n                                <td style=\"vertical-align: middle;\">\n                                    <div style=\"font-size: 6.8px; font-weight: 700; color: #2d3436; text-transform: uppercase;\">Total Net Payable</div>\n                                    <div style=\"font-size: 5.8px; color: #636e72;\">Gross - Deductions</div>\n                                </td>\n                                <td style=\"vertical-align: middle; text-align: right; font-size: 11px; font-weight: 700; color: #2d3436;\">\n                                    \u20b9{{ \"{:,.0f}\".format(doc.net_pay) }}\n                                </td>\n                            </tr>\n                        </table>\n                    </div>\n                    <div style=\"font-size: 6.2px; color: #636e72; padding: 1px 0; margin-top: 1px; text-align: right;\">\n                        <strong>Words:</strong> {{ frappe.utils.money_in_words(doc.grand_net_pay | round(0) if doc.grand_net_pay else doc.net_pay | round(0)) }}\n                    </div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Footer -->\n    <div style=\"text-align: center; font-size: 6px; color: #b2bec3; font-style: italic; margin-top: 1.5px; border-top: 1px solid #f0f0f0; padding-top: 1px;\">\n        This is a system generated document and does not require a signature.\n    </div>\n</div>",
